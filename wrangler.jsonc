{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumenreader-appppp",
  "compatibility_date": "2026-06-04",
  "observability": {
    "enabled": true
  },
  "main": "dist/server/server.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "bun run build"
  }
}
