{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apppppp",
  "compatibility_date": "2026-06-04",
  "observability": {
    "enabled": true
  },
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
